{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" },
    { "type": "panel", "id": "timeseries", "name": "Time series" },
    { "type": "panel", "id": "gauge", "name": "Gauge" },
    { "type": "panel", "id": "stat", "name": "Stat" },
    { "type": "panel", "id": "table", "name": "Table" }
  ],
  "id": null,
  "uid": "fl-privacy-budget",
  "title": "FL Privacy Budget",
  "description": "Differential privacy budget tracking: per-client epsilon consumption, delta values, and exhaustion warnings",
  "tags": ["federated-learning", "fls", "privacy"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "editable": true,
  "style": "dark",
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Per-Client Cumulative Epsilon",
      "description": "Cumulative DP epsilon consumed per client over training rounds. Budget is tracked in Redis under client:{id}:budget. Higher epsilon = less privacy remaining.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 5,
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "mode": "none" },
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 8 }
            ]
          },
          "unit": "none",
          "displayName": "Client {{client_id}}"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "expr": "fl_client_epsilon_consumed{job=\"aggregation-server\"}",
          "legendFormat": "{{client_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Budget Exhaustion Risk",
      "description": "Number of clients whose cumulative epsilon exceeds 80% of the budget limit (approaching exhaustion)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "count(fl_client_epsilon_consumed > 8) or vector(0)",
          "legendFormat": "Clients Near Exhaustion (epsilon > 8)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Updates Rejected (Budget Exhausted)",
      "description": "Rate of updates rejected specifically due to DP budget exhaustion",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "increase(fl_updates_rejected_total{reason=\"budget_exhausted\"}[5m])",
          "legendFormat": "Budget Rejections (5m)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Per-Round Epsilon Consumption",
      "description": "Epsilon consumed per round across all participating clients (rate of change)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "increase(fl_client_epsilon_consumed[5m])",
          "legendFormat": "Client {{client_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Delta Values",
      "description": "DP delta parameter per client (should remain very small, typically 1e-5). Computed from Opacus RDP accountant.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 5,
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "mode": "none" },
            "axisSoftMin": 0
          },
          "unit": "short",
          "decimals": 8
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "fl_client_delta_value{job=\"aggregation-server\"}",
          "legendFormat": "Client {{client_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Client Budget Status",
      "description": "Table showing all clients and their current DP budget state",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [{ "id": "displayName", "value": "Epsilon Consumed" }]
          },
          {
            "matcher": { "id": "byName", "options": "Value #B" },
            "properties": [{ "id": "displayName", "value": "Delta" }]
          },
          {
            "matcher": { "id": "byName", "options": "Value #C" },
            "properties": [{ "id": "displayName", "value": "Updates Accepted" }]
          },
          {
            "matcher": { "id": "byName", "options": "Value #D" },
            "properties": [{ "id": "displayName", "value": "Updates Rejected (Budget)" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      },
      "transformations": [
        { "id": "merge", "options": {} }
      ],
      "targets": [
        {
          "expr": "fl_client_epsilon_consumed",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "fl_client_delta_value",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "fl_updates_accepted_total",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "fl_updates_rejected_total{reason=\"budget_exhausted\"}",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}
