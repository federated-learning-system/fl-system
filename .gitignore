temp/

# Python virtual environment
.venv/
__pycache__/
*.pyc
*.pyo

# Certs (generated, never commit private keys or the K8s secret manifest)
infra/certs/*.crt
infra/certs/*.key
infra/certs/*.pem
infra/certs/*.csr
infra/certs/*.srl
infra/k8s/secrets/tls-secrets.yaml

# Env
.env
.env.*

# Go test artifacts
*.test
*.out

# Trained tokenizer models (regenerate with: .venv/bin/python ml/tokenizer/train_tokenizer.py)
ml/tokenizer/*.model
ml/tokenizer/*.vocab

# Model checkpoints (regenerate with: .venv/bin/python ml/training/warmstart_train.py)
ml/training/checkpoints/
ml/training/warmstart_final.pt

# ONNX exports (regenerate with: make export-model)
ml/model/*.onnx
frontend/keyboard-ui/public/models/*.onnx

# Synthetic client datasets (regenerate with: .venv/bin/python ml/synthetic_data/export_datasets.py)
data/

# Editor
.idea/
.vscode/
*.swp
CLAUDE.md
t.md
/docs
